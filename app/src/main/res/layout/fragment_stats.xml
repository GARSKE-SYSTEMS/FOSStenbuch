<?xml version="1.0" encoding="utf-8"?>
<!-- Statistik: Zeitraum-Auswahl oben, darunter die Kennzahl-Karten bzw. der Leerzustand -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Die ID des gewählten Chips ist zugleich der Filtermodus (siehe StatsFragment.Filter) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_year"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/stats_filter_year" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_custom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_custom" />
        </com.google.android.material.chip.ChipGroup>

        <include
            android:id="@+id/year"
            layout="@layout/stats_stepper" />

        <include
            android:id="@+id/month"
            layout="@layout/stats_stepper"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/stats_from">

                <!-- Nicht tippbar: ein Tipp öffnet die Datumsauswahl -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/date_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/stats_to">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/date_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_stats"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/stats_no_data"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/stats_add_trips_hint"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <include
                android:id="@+id/card_total"
                layout="@layout/stats_card" />

            <include
                android:id="@+id/card_business"
                layout="@layout/stats_card" />

            <include
                android:id="@+id/card_private"
                layout="@layout/stats_card" />

            <include
                android:id="@+id/card_share"
                layout="@layout/stats_card" />

            <include
                android:id="@+id/card_count"
                layout="@layout/stats_card" />

            <include
                android:id="@+id/card_average"
                layout="@layout/stats_card" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
