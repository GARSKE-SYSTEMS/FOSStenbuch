<?xml version="1.0" encoding="utf-8"?>
<!--
  Alle Bildschirme der App. Navigiert wird per Ziel-ID (siehe ui/common/Ui.kt: navigate()).
  Detail-Bildschirme bekommen die Datensatz-ID im Bundle-Schlüssel "id" (0 = neu anlegen).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_trips">

    <!-- Fahrten -->
    <fragment
        android:id="@+id/navigation_trips"
        android:name="de.fosstenbuch.ui.trips.TripsFragment"
        android:label="@string/title_trips" />
    <fragment
        android:id="@+id/navigation_trip_edit"
        android:name="de.fosstenbuch.ui.trips.TripEditFragment"
        android:label="@string/add_edit_trip" />
    <fragment
        android:id="@+id/navigation_ghost_trips"
        android:name="de.fosstenbuch.ui.trips.GhostTripsFragment"
        android:label="@string/title_ghost_trips" />

    <!-- Auswertung -->
    <fragment
        android:id="@+id/navigation_stats"
        android:name="de.fosstenbuch.ui.stats.StatsFragment"
        android:label="@string/title_stats" />
    <fragment
        android:id="@+id/navigation_mileage_calculator"
        android:name="de.fosstenbuch.ui.stats.MileageFragment"
        android:label="@string/title_mileage_calculator" />
    <fragment
        android:id="@+id/navigation_export"
        android:name="de.fosstenbuch.ui.export.ExportFragment"
        android:label="@string/title_export" />

    <!-- Stammdaten -->
    <fragment
        android:id="@+id/navigation_vehicles"
        android:name="de.fosstenbuch.ui.vehicles.VehiclesFragment"
        android:label="@string/title_vehicles" />
    <fragment
        android:id="@+id/navigation_vehicle_edit"
        android:name="de.fosstenbuch.ui.vehicles.VehicleEditFragment"
        android:label="@string/add_edit_vehicle" />
    <fragment
        android:id="@+id/navigation_purposes"
        android:name="de.fosstenbuch.ui.purposes.PurposesFragment"
        android:label="@string/title_purposes" />
    <fragment
        android:id="@+id/navigation_purpose_edit"
        android:name="de.fosstenbuch.ui.purposes.PurposeEditFragment"
        android:label="@string/add_edit_purpose" />
    <fragment
        android:id="@+id/navigation_saved_locations"
        android:name="de.fosstenbuch.ui.locations.LocationsFragment"
        android:label="@string/title_saved_locations" />
    <!-- Optional zusätzlich "name": Vorbelegung des Namens beim Anlegen aus dem Fahrtformular -->
    <fragment
        android:id="@+id/navigation_location_edit"
        android:name="de.fosstenbuch.ui.locations.LocationEditFragment"
        android:label="@string/add_edit_location" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="de.fosstenbuch.ui.settings.SettingsFragment"
        android:label="@string/title_settings" />
</navigation>
