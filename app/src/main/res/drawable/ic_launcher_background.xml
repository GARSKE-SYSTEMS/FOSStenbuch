<?xml version="1.0" encoding="utf-8"?>
<!--
  FOSStenbuch – Hintergrundebene des adaptiven App-Icons ("Garske-Familie").
  Vollflächiges Navy der Garske-Systems-Hausfarbe mit dezentem Verlauf.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Navy-Fläche: diagonaler Verlauf von oben links (#0A3A66) nach unten rechts (#022948) -->
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF0A3A66"
                android:endColor="#FF022948" />
        </aapt:attr>
    </path>
</vector>
